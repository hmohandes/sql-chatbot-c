# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sql_chatbot

# Hugging Face model id and optional token (Gemma 4 is gated; accept the license)
MODEL_ID=google/gemma-4-E4B-it
HF_TOKEN=

# Agent behaviour
TOP_K=5
SAMPLE_ROWS=3
MAX_AGENT_STEPS=16
MAX_NEW_TOKENS=1024
ENABLE_THINKING=false

# Optional: default debug logging for every request
DEBUG=false
